溢出可以透明滚动*/\n  &::-webkit-scrollbar {\n    width: 0;\n  }\n}\n.simple-selector {\n  &__prev, &__next {\n    width: 36px;\n    height: 36px;\n    line-height: 36px;\n    text-align: center;\n    background: fade(#fff, 94%);\n    border-radius: 50%;\n    z-index: 12;\n    cursor: pointer;\n    box-shadow: 0 2px 5px fade(#000, 8%);\n    i {\n      font-size: 16px;\n    }\n    .svgicon {\n      width: 16px;\n      height: 18px;\n    }\n    &.disabled{\n      display: none;\n    }\n\n    &:hover {\n      background: fade(#fff, 100%);\n    }\n  }\n  &__prev {\n    position: absolute;\n    left: 10px;\n    right: auto;\n    top: 50%;\n    margin-top: -18px;\n  }\n  &__next {\n    position: absolute;\n    right: 10px;\n    left: auto;\n    top: 50%;\n    margin-top: -18px;\n  }\n  [mir=rtl] &__prev{\n    right: 10px;\n    left: auto;\n  }\n  [mir=rtl] &__next{\n    left: 10px;\n    right: auto;\n  }\n}\n"],sourceRoot:""}]);const a=l},353466:(e,o,i)=>{"use strict";i.r(o),i.d(o,{default:()=>a});var t=i(655975),n=i.n(t),r=i(687277),l=i.n(r)()(n());l.push([e.id,".common-rate__star{font-size:0}.common-rate__item{color:#facf19!important;display:inline-block}[mir=ltr] .common-rate__item+.common-rate__item{margin-left:3px}[mir=rtl] .common-rate__item+.common-rate__item{margin-right:3px}[mir=ltr] .common-rate__icon{transform:rotateY(0deg)}[mir=rtl] .common-rate__icon{transform:rotateY(180deg)}","",{version:3,sources:["webpack://./public/src/pages/detail/main/components/common/CommonRate.vue","webpack://./public/src/less/mixins/lib.less"],names:[],mappings:"AAGE,mBACE,WAyBJ,CAvBE,mBAEE,uBAAA,CADA,oBA2BJ,CAzBI,gDCiCA,eDLJ,CA5BI,gDCiCA,gBDLJ,CAxBE,6BACE,uBA0BJ,CA3BE,6BACE,yBA0BJ",sourcesContent:["@import '~public/src/less/variables.less';@import '~public/src/less/mixins/lib.less';@import '~public/src/less/mixins/grid.less';@import '~public/src/less/mixins/buttons.less';@import '~public/src/less/mixins/clamp.less';@sui_color_brand: #000000;@sui_color_main: #222222;@sui_color_discount: #F