QAiBN,CAVE,kCACE,cAAA,CACA,eAYJ,CAVE,+CAIE,UAYJ,CAhBE,qDAGE,kBAAA,CADA,kBAAA,CADA,eAeJ,CAVE,oCAOE,UAAA,CALA,cAAA,CACA,eAAA,CAEA,gBAAA,CADA,gBAeJ,CAnBE,0CACE,kBAkBJ,CAnBE,8CAME,eAaJ,CAnBE,8CAME,gBAaJ,CAXI,0CAEE,aAcN,CAhBI,gDACE,cAAA,CAEA,cAaN,CAZM,+CACE,oBAeR,CAhBM,qDAEE,iBAcR,CAXI,gDACE,UAaN,CAXI,wDACE,cAaN,CAVE,sCAIE,kBAAA,CACA,UAAA,CAFA,YAAA,CAFA,cAAA,CACA,eAgBJ,CAlBE,4CAME,iBAYJ,CAVI,6CACE,UAAA,CACA,oBAAA,CAEA,UAAA,CADA,SAgBN,CAnBI,mDAKE,kBAAA,CACA,iBAaN,CAnBI,uDAOE,gBAYN,CAnBI,uDAOE,eAYN,CATE,qCACE,YAaJ,CAdE,2CAGE,iBAAA,CADA,cAYJ,CAVI,yCAGE,WAAA,CADA,UAaN,CAfI,mDACE,iBAcN,CAfI,mDACE,gBAcN,CATE,sCACE,YAYJ,CAbE,4CAEE,cAWJ,CAVI,0CAEE,UAYN,CAdI,oDACE,gBAaN,CAdI,oDACE,eAaN,CATE,oCACE,YAYJ,CAbE,0CAEE,kBAWJ,CATE,yCAGE,kBAAA,CAFA,YAAA,CACA,qBAAA,CAGA,WAAA,CADA,WAaJ,CAjBE,mDAME,8BAWJ,CAjBE,mDAME,6BAWJ,CARI,6CAIE,WAAA,CADA,UAWN,CAdI,mDAEE,iBAAA,CADA,eAaN,CAPI,2CAIE,aAAA,CAHA,cAAA,CACA,eAAA,CACA,gBAAA,CAEA,UAUN,CAfI,iDAME,iBASN,CANI,8DACE,iBAQN,CATI,8DACE,gBAQN",sourcesContent:["@import '~public/src/less/variables.less';@import '~public/src/less/mixins/lib.less';@import '~public/src/less/mixins/grid.less';@import '~public/src/less/mixins/buttons.less';@import '~public/src/less/mixins/clamp.less';@sui_color_brand: #000000;@sui_color_main: #222222;@sui_color_discount: #FA6338;@sui_color_discount_dark: #C44A01;@sui_color_promo: #FA6338;@sui_color_promo_dark: #C44A01;@sui_color_promo_bg: #FFF6F3;@sui_color_highlight: #C44A01;@sui_color_highlight_special: #337EFF;@sui_color_welfare: #FA6338;@sui_color_welfare_dark: #C44A01;@sui_color_welfare_bg: #FFF6F3;@sui_color_honor: #FACF19;@sui_color_safety: #198055;@sui_color_safety_bg: #F5FCFB;@sui_color_new: #3CBD45;@sui_color_link: #2D68A8;@sui_color_note_light_bg: #EFF3F8;@sui_color_flash: #FACF19;@sui_color_guide: #FE3B30;@sui_color_unusual: #BF4123;@sui_color_unusual_bg: #FAF0EE;@sui_color_success: #198055;@sui_color_prompt_unusual: #FFE1DB;@sui_color_prompt_warning: #FFF1D5;@sui_color_prompt_success: #E5F5E6;@sui_color_prompt_common: #D9EAFF;@sui_color_button_stroke_light: #BBBBBB;@sui_color_micro_emphasis: #A86104;@sui_color_micro_emphasis_bg: #FFF8EB;@sui_color_lightgreen: #198055;@sui_color_warning: #EF9B00;@sui_color_black: #000000;@sui_color_black_alpha80: rgba(0,0,0,.8);@sui_color_black_alpha60: rgba(0,0,0,.6);@sui_color_black_alpha30: rgba(0,0,0,.3);@sui_color_white: #ffffff;@sui_color_white_alpha80: rgba(255,255,255,.8);@sui_color_white_alpha60: rgba(255,255,255,.6);@sui_color_white_alpha30: rgba(255,255,255,.3);@sui_color_white_alpha96: rgba(255,255,255,.96);@sui_color_gray_dark1: #222222;@sui_color_gray_alpha60: rgba(34,34,34,.6);@sui_color_gray_alpha30: rgba(34,34,34,.3);@sui_color_gray_dark2: #666666;@sui_color_gray_dark3: #767676;@sui_color_gray_light1: #959595;@sui_color_gray_light2: #bbbbbb;@sui_color_gray_light3: #cccccc;@sui_color_gray_weak1: #e5e5e5;@sui_color_gray_weak2: #F6F6F6;@sui_color_gray_weak1a: #F2F2F2;@sui_color_club_rosegold_dark1: #873C00;@sui_color_club_rosegold_dark2: #C96E3F;@sui_color_club_rosegold_dark3: #DA7E50;@sui_color_club_rosegold_dark4: #EAA27E;@sui_color_club_rosegold: #FFBA97;@sui_color_club_rosegold_light1: #FFD8C4;@sui_color_club_rosegold_light2: #FFE2D3;@sui_color_club_gold: #FEECC3;@sui_color_club_black: #161616;@sui_color_club_orange: #FF7F46;\n\n.shipping-guarantee {\n  display: flex;\n  position: relative;\n  &__padding {\n    .padding-l(20px);\n  }\n  &__content {\n    cursor: pointer;\n    display: flex;\n    flex-direction: column;\n    overflow-x: auto; /* 添加水平滚动 */\n  }\n  &__icon {\n    width: 32px;\n    min-width: 32px;\n    cursor: pointer;\n  }\n  &__labelpage {\n    position: absolute;\n    right: 0;\n    top: 2px;\n    font-size: 12px;\n    font-weight: 400;\n    display: flex;\n    align-items: center;\n    &_dark-bg {\n      margin-right: 8px\n    }\n  }\n  &__content-title {\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 14px;\n    height: 24px;\n    display: flex;\n    align-items: center;\n    // margin-bottom: 4px;\n    &_highlight {\n      color: #198055;\n    }\n    // .icon-left, \n    // .icon-right {\n    //   font-size: 12px;\n    //   color: #999;\n    //   cursor: not-allowed;\n    //   display: inline-block;\n    //   transform: unset /* rtl: rotate(0deg) */;\n    //   &.shipping-guarantee__shipactive {  \n    //     color: #000;\n    //     cursor: pointer;\n    //     font-weight: 700;\n    //   }\n    // }\n\n    .svg-icon-left {\n      margin-right: 2px;\n    }\n    .svg-icon-right {\n      margin-left: 2px;\n    }\n    .svg-icon-left, \n    .svg-icon-right {\n      font-size: 12px;\n      color: #999 !important /* stylelint-disable-line declaration-no-important */;\n      cursor: not-allowed;\n      display: inline-block;\n      transform: unset /* rtl: rotate(0deg) */;\n      &.shipping-guarantee__shipactive {  \n        color: #000 !important /* stylelint-disable-line declaration-no-important */;\n        cursor: pointer;\n        font-weight: bold !important /* stylelint-disable-line declaration-no-important */;\n      }\n    }\n  }\n  &__content-items {\n    display: flex;\n    overflow-x: auto; /* 添加水平滚动 */\n    scrollbar-width: none;\n    &::-webkit-scrollbar {\n      display: none;\n    }\n    &_highlight {\n      background-color: #F4FAF8;\n      padding-top: 0px;\n      padding-left: 8px; // 当有绿色高亮背景，需要在上下左右加上 padding，绿色图层包裹住 item\n      padding-right: 8px;\n      height: 30px;\n    }\n    &_dark-highlight {\n      background-color: #EEFAF8;\n      padding-left: 8px;\n      padding-right: 8px;\n      margin-right: 8px;\n      height: 30px;\n    }\n  }\n  &__content-column-items {\n    display: flex;\n    flex-direction: column;\n  }\n  &__content-item {\n    display: flex;\n    align-items: center;\n    font-size: 12px;\n    font-weight: 400;\n    line-height: 14px;\n    margin-right: 24px;\n    margin-bottom: 6px;\n    color: @sui_color_gray_dark2;\n    white-space: nowrap;\n    &_compact {\n      margin-right: 12px;\n    }\n    &_has-before::before {\n      color: #666666;\n      content: '';\n      display: inline-block;\n      width: 4px;\n      height: 4px;\n      background: #198055;\n      border-radius: 4px;\n      margin-right: 4px;\n    }\n  }\n  &__content-items_one-line {\n    .shipping-guarantee__content-item {\n      margin-bottom: 0;\n    }\n  }\n  &__fold-btn {\n    position: absolute;\n    font-weight: normal;\n    right: 0;\n    top: 6px;\n    &_dark-bg {\n      right: 8px\n    }\n  }\n  \n}\n\n.shipping-guarantee-dialog {\n  &__title {\n    font-size: 16px;\n    font-weight: 700;\n  }\n  &__title-segmentation {\n    margin-top: 20px;\n    margin-bottom: 25px;\n    background: #E5E5E5;\n    height: 1px;\n  }\n  &__section {\n    margin-bottom: 24px;\n    font-size: 12px;\n    font-weight: 400;\n    line-height: 14px;\n    letter-spacing: 0px;\n    text-align: left;\n    color: #666666;\n    & > .link {\n      cursor: pointer;\n      color: #2D68A8;\n      margin-top: 2px;\n      & > span {\n        display: inline-block;\n        margin-bottom: 1px;\n      }\n    }\n    & > .holder-8px {\n      height: 8px;\n    }\n    & > .marginTop8px {\n      margin-top: 8px;\n    }\n  }\n  &__sub-title {\n    font-size: 12px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    color: #000;\n    margin-bottom: 8px;\n\n    &::before {\n      content: '';\n      display: inline-block;\n      width: 4px;\n      height: 4px;\n      background: #198055;\n      border-radius: 4px;\n      margin-right: 4px;\n    }\n  }\n  &__pay-imgs {\n    display: flex;\n    margin-top: 6px;\n    margin-bottom: 8px;\n    & > img {\n      margin-right: 12px;\n      width: 38px;\n      height: 25px;\n    }\n  }\n  &__card-imgs {\n    display: flex;\n    margin-top: 6px;\n    & > img {\n      margin-right: 8px;\n      width: 69px;\n    }\n  }\n  &__contact {\n    display: flex;\n    background: #F6F6F6;\n  }\n  &__contact-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 199px;\n    height: 90px;\n    border-right: 1px solid #E5E5E5;\n\n\n    & > img {\n      margin-top: 12px;\n      margin-bottom: 8px;\n      width: 30px;\n      height: 30px;\n    }\n\n    & > p {\n      font-size: 12px;\n      font-weight: 400;\n      line-height: 14px;\n      color: #767676;\n      width: 92px;\n      text-align: center;\n    }\n\n    &:last-child {\n      border-right: none;\n    }\n  }\n}\n",'// Clearfix\n//\n// For modern browsers\n// 1. The space content is one way to avoid an Opera bug when the\n//    contenteditable attribute is included anywhere else in the document.\n//    Otherwise it causes space to appear at the top and bottom of elements\n//    that are clearfixed.\n// 2. The use of `table` rather than `block` is only necessary if using\n//    `:before` to contain the top-margins of child elements.\n//\n// Source: http://nicolasgallagher.com/micro-clearfix-hack/\n\n.clearfix() {\n  &:before,\n  &:after {\n    content: " "; // 1\n    display: table; // 2\n  }\n  &:after {\n    clear: both;\n  }\n}\n\n.fl() {\n    float: left !important; /* stylelint-disable-line declaration-no-important */\n}\n.fr() {\n    float: right !important; /* stylelint-disable-line declaration-no-important */\n}\n.normal-fl(){\n    float: left;\n}\n.normal-fr(){\n    float: right;\n}\n.txt-l() {\n    text-align: left;\n}\n.txt-r() {\n    text-align: right;\n}\n.margin-l(@size) {\n    margin-left: @size;\n}\n.margin-r(@size) {\n    margin-right: @size;\n}\n.padding-l(@size) {\n    padding-left: @size;\n}\n.padding-r(@size) {\n    padding-right: @size;\n}\n.border-l(@size, @color) {\n    border-left: @size solid @color;\n}\n.border-r(@size, @color) {\n    border-right: @size solid @color;\n}\n.border-r-type(@size, @color, @type) {\n    border-right: @size @type @color;\n}\n.transform-origin-l() {\n  transform-origin: left;\n}\n.transform-origin-r() {\n  transform-origin: right;\n}\n.left(@size) {\n    left: @size;\n}\n.right(@size) {\n    right: @size;\n}