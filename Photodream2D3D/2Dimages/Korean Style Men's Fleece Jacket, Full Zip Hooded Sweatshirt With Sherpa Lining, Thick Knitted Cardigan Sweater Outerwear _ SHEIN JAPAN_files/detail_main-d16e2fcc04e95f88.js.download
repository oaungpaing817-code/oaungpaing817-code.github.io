\n    color: #222;\n    position: relative;\n    overflow-x: hidden;\n  }\n\n  &__img-attr-title {\n    margin: 0 0 10px;\n    font-weight: 600;\n  }\n  &__img-attr-list {\n    .flexbox;\n    flex-wrap: wrap;\n\n    &:last-child {\n      margin-bottom: 16px;\n    }\n  }\n  &__img-attr-li {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    width: 116px;\n    padding: 2px 8px 8px;\n    border: 0.5px solid @sui_color_gray_weak1;\n    margin-right: 8px;\n    margin-bottom: 8px;\n    &:first-child {\n      margin-left: 0;\n    }\n\n    img {\n      display: block;\n      margin: 0 auto 2px;\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n    }\n    p {\n      text-align: center;\n      .clamp(2);\n    }\n\n    & .desc {\n      color: #767676;\n      margin-top: 2px;\n    }\n  }\n\n  .horizon-scroll-box {\n    transition: all 0.2s;\n  }\n\n  &__scroll-arrow {\n    position: absolute;\n    top: calc(50% - 14px);\n    width: 36px;\n    height: 36px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background-color: #fff;\n    border-radius: 50%;\n    cursor: pointer;\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);\n\n    &.left {\n      left: 8px;\n    }\n    &.right {\n      right: 8px;\n    }\n  }\n}\n",".clamp(@line){\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-line-clamp: @line;\n    -webkit-box-orient: vertical;\n    word-break: break-all;\n}\n\n// flex布局\n.flexbox() {\n  display: -webkit-box;\n  display: -moz-box;\n  display: flex;\n  display: -ms-flexbox;\n}\n// flex 垂直居中\n.align-center() {\n  -webkit-align-items: center;\n    -webkit-box-align: center;\n       -moz-box-align: center;\n       -ms-flex-align: center;\n             box-flex: center;\n          align-items: center;\n}\n// flex 水平居中\n.pack-center() {\n  -webkit-justify-content: center;\n         -webkit-box-pack: center;\n            -moz-box-pack: center;\n            -ms-flex-pack: center;\n        